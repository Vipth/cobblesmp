# ---- Discord ----
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
GUILD_ID=
# Role whose members may run admin/RCON commands (/ban, /kick, /give, ...)
ADMIN_ROLE_ID=
# Channel where the bot posts audit lines and ban-sync proposals
LOG_CHANNEL_ID=

# ---- Minecraft RCON ----
RCON_HOST=127.0.0.1
RCON_PORT=25575
RCON_PASSWORD=
# true = log the commands the bot would send instead of actually sending them
RCON_DRY_RUN=false

# ---- Ban sync ----
# How often to poll the Minecraft banlist (ms). Keep >= 60000 on a Raspberry Pi.
BAN_SYNC_INTERVAL_MS=60000
# auto   = the bot bans/unbans on Discord automatically when it sees a MC ban change
# propose = the bot posts an embed with buttons in LOG_CHANNEL_ID for an admin to confirm
BAN_SYNC_MODE=propose
# Minutes to ignore a name on the banlist after the bot itself actioned it (loop guard)
BAN_SYNC_LOOP_GUARD_MINUTES=5

# ---- Whitelist / link-to-play enforcement ----
# off      = /link adds to the whitelist, /unlink removes, nothing else (default)
# additive = also run `whitelist on`, keep every linked user whitelisted, and
#            REPORT (never remove) whitelisted accounts that have no Discord link
# strict   = additive + REMOVE and kick whitelisted accounts that aren't linked or exempt
# Also set white-list=true and enforce-whitelist=true in server.properties.
WHITELIST_MODE=off
# Comma-separated usernames the reconciler never adds or removes (ops, admin alts).
WHITELIST_EXEMPT=
# How often the whitelist reconciler runs (ms, min 60000).
WHITELIST_RECONCILE_INTERVAL_MS=300000

# ---- Misc ----
# In-game prefix for /say (tellraw, not the vanilla "[Rcon]" tag).
# Supports legacy & colour codes: &6 gold, &c red, &l bold, &r reset, etc.
SAY_PREFIX=&6[&cBroadcast&6]
# Fallback colour for any prefix text without a & code, and the default message colour.
# A Minecraft colour name (gold, aqua, dark_red, ...) or #RRGGBB.
SAY_PREFIX_COLOR=gold
SAY_DEFAULT_COLOR=white
# Path to the sqlite file (directory must be writable / bind-mounted in Docker)
DATABASE_PATH=./data/cobblesmp.db
# true = (re)register slash commands on every boot instead of running `npm run deploy`
DEPLOY_COMMANDS_ON_START=false
